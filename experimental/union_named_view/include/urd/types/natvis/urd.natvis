<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2006">

  <!--
    urd::v2::tuple<Ts...>
    Layout: struct tuple<Head,Tail...> { Head head; tuple<Tail...> tail; }
  -->

  <Type Name="urd::v2::tuple&lt;&gt;">
    <DisplayString>(empty)</DisplayString>
  </Type>

  <Type Name="urd::v2::tuple&lt;$T1&gt;">
    <DisplayString>[1] = ({head})</DisplayString>
    <Expand>
      <Item Name="[0]">head</Item>
    </Expand>
  </Type>

  <Type Name="urd::v2::tuple&lt;$T1,$T2&gt;">
    <DisplayString>[2]</DisplayString>
    <Expand>
      <Item Name="[0]">head</Item>
      <Item Name="[1]">tail.head</Item>
    </Expand>
  </Type>

  <Type Name="urd::v2::tuple&lt;$T1,$T2,$T3&gt;">
    <DisplayString>[3]</DisplayString>
    <Expand>
      <Item Name="[0]">head</Item>
      <Item Name="[1]">tail.head</Item>
      <Item Name="[2]">tail.tail.head</Item>
    </Expand>
  </Type>

  <Type Name="urd::v2::tuple&lt;$T1,$T2,$T3,$T4&gt;">
    <DisplayString>[4]</DisplayString>
    <Expand>
      <Item Name="[0]">head</Item>
      <Item Name="[1]">tail.head</Item>
      <Item Name="[2]">tail.tail.head</Item>
      <Item Name="[3]">tail.tail.tail.head</Item>
    </Expand>
  </Type>

  <Type Name="urd::v2::tuple&lt;$T1,$T2,$T3,$T4,$T5&gt;">
    <DisplayString>[5]</DisplayString>
    <Expand>
      <Item Name="[0]">head</Item>
      <Item Name="[1]">tail.head</Item>
      <Item Name="[2]">tail.tail.head</Item>
      <Item Name="[3]">tail.tail.tail.head</Item>
      <Item Name="[4]">tail.tail.tail.tail.head</Item>
    </Expand>
  </Type>

  <Type Name="urd::v2::tuple&lt;$T1,$T2,$T3,$T4,$T5,$T6&gt;">
    <DisplayString>[6]</DisplayString>
    <Expand>
      <Item Name="[0]">head</Item>
      <Item Name="[1]">tail.head</Item>
      <Item Name="[2]">tail.tail.head</Item>
      <Item Name="[3]">tail.tail.tail.head</Item>
      <Item Name="[4]">tail.tail.tail.tail.head</Item>
      <Item Name="[5]">tail.tail.tail.tail.tail.head</Item>
    </Expand>
  </Type>

  <Type Name="urd::v2::tuple&lt;$T1,$T2,$T3,$T4,$T5,$T6,$T7&gt;">
    <DisplayString>[7]</DisplayString>
    <Expand>
      <Item Name="[0]">head</Item>
      <Item Name="[1]">tail.head</Item>
      <Item Name="[2]">tail.tail.head</Item>
      <Item Name="[3]">tail.tail.tail.head</Item>
      <Item Name="[4]">tail.tail.tail.tail.head</Item>
      <Item Name="[5]">tail.tail.tail.tail.tail.head</Item>
      <Item Name="[6]">tail.tail.tail.tail.tail.tail.head</Item>
    </Expand>
  </Type>

  <Type Name="urd::v2::tuple&lt;$T1,$T2,$T3,$T4,$T5,$T6,$T7,$T8&gt;">
    <DisplayString>[8]</DisplayString>
    <Expand>
      <Item Name="[0]">head</Item>
      <Item Name="[1]">tail.head</Item>
      <Item Name="[2]">tail.tail.head</Item>
      <Item Name="[3]">tail.tail.tail.head</Item>
      <Item Name="[4]">tail.tail.tail.tail.head</Item>
      <Item Name="[5]">tail.tail.tail.tail.tail.head</Item>
      <Item Name="[6]">tail.tail.tail.tail.tail.tail.head</Item>
      <Item Name="[7]">tail.tail.tail.tail.tail.tail.tail.head</Item>
    </Expand>
  </Type>

  <!-- Catch-all: if this shows, the specific $Tn patterns above did not match -->
  <Type Name="urd::v2::tuple&lt;*&gt;">
    <DisplayString>urd_tuple_NO_MATCH</DisplayString>
    <Expand>
      <Item Name="head">head</Item>
    </Expand>
  </Type>

  <!-- urd::v2::pool<T> -->
  <Type Name="urd::v2::pool&lt;$T1&gt;">
    <DisplayString>[{data._Mypair._Myval2._Mylast - data._Mypair._Myval2._Myfirst} elements in {offsets._Mypair._Myval2._Mylast - offsets._Mypair._Myval2._Myfirst} slots]</DisplayString>
    <Expand>
      <Item Name="total">data._Mypair._Myval2._Mylast - data._Mypair._Myval2._Myfirst</Item>
      <Item Name="slots">offsets._Mypair._Myval2._Mylast - offsets._Mypair._Myval2._Myfirst</Item>
      <ArrayItems>
        <Size>data._Mypair._Myval2._Mylast - data._Mypair._Myval2._Myfirst</Size>
        <ValuePointer>data._Mypair._Myval2._Myfirst</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

</AutoVisualizer>
